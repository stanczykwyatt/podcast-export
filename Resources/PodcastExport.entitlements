<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Everything Podcast Export is allowed to do. The App Sandbox blocks anything not listed here.
	There is no network entitlement, so it cannot connect to the internet at all, and no Apple
	Events, so it cannot control other apps, Apple Podcasts included.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Read-only access to the Apple Podcasts library, and nothing else in your home folder.
	     macOS also requires Full Disk Access for it, which you turn on. Writing there is blocked.
	     Sources/PodcastCore/Library.swift names the same folder, and a test checks the two match. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/Library/Group Containers/243LU875E5.groups.com.apple.podcasts/Documents/</string>
	</array>
	<!-- Read and write access to the folder you choose to export to, or the file you save the
	     OPML as, and nothing else. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Lets the app remember that folder after it quits, instead of asking every time. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
